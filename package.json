{
  "name": "@hackersandwizards/mcp-fathom-server",
  "version": "2.0.1",
  "description": "MCP server for Fathom AI meeting API integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-fathom-server": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "bun src/index.ts",
    "test": "bun test",
    "check": "tsc --noEmit && bun test",
    "inspect": "bunx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "fathom",
    "meetings",
    "ai"
  ],
  "author": "hackers&wizards",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
